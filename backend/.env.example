# ============================================================
# HIS Data Hub — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
PORT=5000

# ------------------------------------------------------------
# SQL Server Connection
# Use the format: HOSTNAME\INSTANCE  (or just HOSTNAME for default instance)
# Example local named instance: DESKTOP-XXXXXXX\SQLEXPRESS
# Example default instance:     DESKTOP-XXXXXXX
# ------------------------------------------------------------
DB_SERVER=localhost
DB_DATABASE=HISDataHub
DB_USER=sa
DB_PASSWORD=Divine_the_Legend007

# ------------------------------------------------------------
# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=bccadfc15c0d078a0c677337a46387f86c5bbab89f4a50d725bdfe0033d30c57

# ------------------------------------------------------------
# TIXO Helpdesk Integration
# Service account credentials used by the backend to create tickets.
# ------------------------------------------------------------
TIXO_API_URL=https://tixo.cubiq-solutions.com
TIXO_SERVICE_EMAIL=his-hub@yourdomain.com
TIXO_SERVICE_PASSWORD=your_tixo_service_account_password
